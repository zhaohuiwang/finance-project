

# First create a .env copy from the example, $ cp .env.example .env
# Then replace with your own APP_KEY and APP_SECRET
# save .env file in project root dir or preferred working dir 




# save .env file in project root dir or preferred working dir 
############################################################
########## Schwab ##########
SCHWAB_API_KEY = "your-api-key-value"
SCHWAB_API_SECRET = "your-api-key-value"
SCHWAB_CALLBACK_URL = "https://127.0.0.1"
SCHWAB_ACCOUNT_NUMBER = "your-account-number"
# TOKEN_URL = "https://api.schwabapi.com/v1/oauth/token"
# TOKEN_FILE_PATH = "schwab_dev/src/configs/.tokens.json"


############################################################
########## Alpaca API credentials ##########
# API Keys Endpoint: https://api.alpaca.markets
ALPACA_API_KEY=your-key-value
ALPACA_API_SECRET_KEY=your-key-value
# API Keys Endpoint: https://paper-api.alpaca.markets/v2
PAPER_ALPACA_API_KEY=your-key-value
PAPER_ALPACA_API_SECRET_KEY=your-key-value

############################################################
####### SEC (U.S. Securities and Exchange Commission) ######
# The User-Agent lets the SEC distinguish your application from anonymous/badly identified traffic. It is not a password, API key, token, or credential. It is used in the HTTP request. For example,
# requests.get(
#     "https://data.sec.gov/submissions/CIK0000320193.json",
#     headers={
#         "User-Agent": SEC_USER_AGENT
#     }
# )
SEC_USER_AGENT="EquityForge (your-email)"


############################################################
########## Alert ###########
ALPHA_VANTAGE_API_KEY=your-key-value


############################################################
########## Federal Reserve ##########
# Federal Reserve Economic Data (FRED) API https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = "your-key-value"
SHARADAR_API_KEY = "your-key-value"
# this is the API for sample data only.


