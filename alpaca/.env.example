
# Alpaca — paper trading
ALPACA_PAPER_API_KEY=your-paper-api-key
ALPACA_PAPER_SECRET_KEY=your-paper-secret-key

# Alpaca — live trading (only needed when paper_trading: false)
ALPACA_API_KEY=your-live-api-key
ALPACA_SECRET_KEY=your-live-secret-key

# Anthropic — required for agent_trader.py
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — optional, for trade alerts
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# First create a .env copy from the example: cp .env.example .env
# Then fill in your actual keys and save.